# Copie para local.env e ajuste. Tudo é opcional.
# KANBAN_PORT=8765                 # porta (o servidor só ouve em 127.0.0.1)
# KANBAN_TMUX=kanban               # sessão do tmux onde as sessões do Claude abrem
# KANBAN_REPOS_ROOT=~/Projects     # pasta com seus repositórios (oferecidos ao iniciar uma sessão)
# KANBAN_ORG=                      # organização padrão (vazio = a primeira do orgs.tsv)
# KANBAN_HOSTS=meu-pc.tailnet.ts.net   # nomes extras aceitos, ex.: `tailscale serve` (nunca exponha na internet)
# KANBAN_PUSH_SUB=https://meu-pc.tailnet.ts.net  # remetente das notificações push (padrão: 1º de KANBAN_HOSTS)
# PRs citados pelo nome curto ("api#12" = minha-org/api#12):
# KANBAN_GH_ORG=minha-org
# KANBAN_PR_PREFIX=
# KANBAN_PR_SHORT=api,web
# KANBAN_VOICE=1                   # Jarvis (voz), experimental
